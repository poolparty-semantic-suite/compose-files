
{
  "service": {
    "name": "Mirror Service Example",
    "control": "@servers[local]",
    "token": "YOUR_SERVICE_TOKEN"
  },
  "servers": {
    "local": {
      "host": "https://source.example.com",
      "user": "SOURCE_API_USER",
      "password": "SOURCE_API_PASSWORD"
    },
    "target": {
      "host": "https://target.example.com",
      "user": "TARGET_API_ADMIN",
      "password": "TARGET_API_PASSWORD"
    }
  },
  "routes": [
    {
      "filter": "%",
      "source": {
        "server": "@servers[local]",
        "export_parameters": {
          "modules": [
            "concepts",
            "blacklistedTerms"
          ]
        }
      },
      "targets": [
        {
          "server": "@servers[target]"
        }
      ]
    }
  ],
  "checkhooks": [
    {
      "method": "GET",
      "url": "http://hook-receiver:9001/check/200",
      "auth": {
        "user": "HOOK_USERNAME",
        "password": "HOOK_PASSWORD"
      }
    }
  ],
  "webhooks": [
    {
      "type": "notification",
      "onSuccess": true,
      "onFailure": false,
      "url": "http://hook-receiver:9001/notify/200",
      "auth": {
        "user": "HOOK_USERNAME",
        "password": "HOOK_PASSWORD"
      }
    },
    {
      "type": "notification",
      "onSuccess": true,
      "onFailure": false,
      "url": "http://hook-receiver:9001/notify/200",
      "auth": {
        "protocol": "oauth2",
        "token_url": "http://hook-receiver:9001/token",
        "grant_type": "client_credentials",
        "scope": ".default",
        "client_id": "OAUTH_CLIENT_ID",
        "client_secret": "OAUTH_CLIENT_SECRET"
      }
    },
    {
      "type": "notification",
      "onSuccess": true,
      "onFailure": false,
      "url": "http://hook-receiver:9001/notify/200"
    }
  ]
}