###############################################################################
# 1. GLOBAL & NETWORK CONFIGURATION
###############################################################################
# Hostname (FQDN, DNS or IP) of the server hosting PoolParty and related services.
# Used by Nginx proxy and internal extra_hosts resolution.
SERVER_NAME=poolparty.127.0.0.1.nip.io

# Public base HTTP(S) address used by browsers to access the platform.
SERVER_URL="http://${SERVER_NAME}"

###############################################################################
# 2. REVERSE PROXY (NGINX) & SSL CONFIGURATION
###############################################################################
# Configures the maximum acceptable request body size by the proxy.
PROXY_CLIENT_MAX_BODY_SIZE=100M

# Maximum time proxy waits for upstream to start reading the request / return a response.
PROXY_SEND_TIMEOUT=5m
PROXY_READ_TIMEOUT=5m

# Path to the proxy template configuration file.
# Default: ./files/nginx/proxy.conf (or ./files/nginx/proxy_ssl.conf when running ssl.yaml)
PROXY_CONFIG_PATH=./files/nginx/proxy.conf

# SSL configuration (only required when using ssl.yaml)
# Paths on the host to SSL certificate and private key.
PROXY_CERT_PATH=./poolparty.crt
PROXY_CERT_KEY_PATH=./poolparty.key

###############################################################################
# 3. KEYCLOAK IDENTITY PROVIDER & DATABASE
###############################################################################
# Context path where Keycloak is exposed (mirrored in Nginx proxy)
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded

# Keycloak public base URL and dynamic backchannel settings
KC_HOSTNAME="${SERVER_URL}${KC_HTTP_RELATIVE_PATH}"
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true

# Public browser-facing URL (via proxy) and internal Docker network backchannel URL
POOLPARTY_KEYCLOAK_PUBLIC_AUTHURL="${KC_HOSTNAME}"
POOLPARTY_KEYCLOAK_INTERNAL_AUTHURL="http://keycloak:8080${KC_HTTP_RELATIVE_PATH}"

# Backward-compatible alias used by PoolParty container (internal backchannel)
POOLPARTY_KEYCLOAK_AUTHURL="${POOLPARTY_KEYCLOAK_INTERNAL_AUTHURL}"

# Master Admin credentials (used to provision Keycloak and admin API calls)
KEYCLOAK_ADMIN=poolparty_auth_admin
KEYCLOAK_ADMIN_PASSWORD=admin
POOLPARTY_KEYCLOAK_ADMIN_CLIENTID=admin-cli

# Realm identifiers
KC_REALM=poolparty
POOLPARTY_KEYCLOAK_LOGIN_REALM=${KC_REALM}
POOLPARTY_KEYCLOAK_ADMIN_REALM=master

# Initial PoolParty superadmin credentials
POOLPARTY_SUPER_ADMIN_PASSWORD=poolparty

# Keycloak Database Configuration (used in production.yaml)
KC_DB=postgres
KC_DB_URL_HOST=db
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=kc_user
KC_DB_PASSWORD=secret

# PostgreSQL Container Credentials (used in production.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

###############################################################################
# 4. KEYCLOAK CLIENT IDENTIFIERS & SECRETS
###############################################################################
# Client ID identifiers
KC_GM_CLIENT=ppt
KC_GDB_CLIENT=graphdb

# PoolParty (PPT) Client
POOLPARTY_PPT_KEYCLOAK_LOGIN_CLIENTID=${KC_GM_CLIENT}
POOLPARTY_PPT_KEYCLOAK_LOGIN_CLIENTSECRET=ohIP3x4XuoCsGDsGlZRvNvO5VN6veFb5

# GraphSearch (PPGS) Client
POOLPARTY_PPGS_KEYCLOAK_LOGIN_CLIENTID=ppgs
POOLPARTY_PPGS_KEYCLOAK_LOGIN_CLIENTSECRET=ohIP3x4XuoCsGDsGlZRvNvO5VN6veFb52

# Extractor (PPX) Client
POOLPARTY_PPX_KEYCLOAK_LOGIN_CLIENTID=extractor
POOLPARTY_PPX_KEYCLOAK_LOGIN_CLIENTSECRET=ohIP3x4XuoCsGDsGlZRvNvO5VN6veFb53

# Recommender Client
RECOMMENDER_KEYCLOAK_LOGIN_CLIENTSECRET=ohIP3x4XuoCsGDsGlZRvNvO5VN6veFb54

# Audience enforcement toggle for OpenID tokens
POOLPARTY_AUTH_OPENID_REQUIRE_AUDIENCE=false

###############################################################################
# 5. POOLPARTY CORE SERVICE
###############################################################################
# Absolute or relative host path to the PoolParty license file
POOLPARTY_LICENSE=/path/to/poolparty.key

# Maximum heap allocation for PoolParty JVM
PP_HEAP_SIZE=8g

# Allowed CORS origins
POOLPARTY_CORS_ALLOWEDORIGINS=${SERVER_URL}

# Base URI schemes used for taxonomy and concept generation
_POOLPARTY_URL_BASE_SCHEME=${SERVER_URL}
_POOLPARTY_URL_BASE_VOCABULARY=${SERVER_URL}
_POOLPARTY_URL_BASE_USER=${SERVER_URL}/user
_POOLPARTY_URL_BASE_CONTEXT=${SERVER_URL}

# Encryption password used to encode/decode PoolParty secrets stored in GraphDB
_POOLPARTY_ENCRYPTION_PASSWORD=1234567890

###############################################################################
# 6. GRAPHDB SERVICE & GRAPH MODELING OAUTH2 INTEGRATION
###############################################################################
# Host path to the GraphDB license file
GRAPHDB_LICENSE=/path/to/graphdb.license

# GraphDB endpoints
POOLPARTY_GRAPHDB_URL=http://graphdb:7200
GRAPHDB_PUBLIC_URL="${SERVER_URL}/graphdb"
graphdb__external___url=${GRAPHDB_PUBLIC_URL}

# Optional direct basic credentials or custom auth header for GraphDB (used in docker-compose.yaml & migration.yaml)
POOLPARTY_GRAPHDB_USERNAME=
POOLPARTY_GRAPHDB_PASSWORD=
POOLPARTY_GRAPHDB_AUTHORIZATIONHEADER=

# GraphDB OAuth2 Configuration (used in oauth.yaml)
graphdb__auth__methods=openid
graphdb__auth__database=oauth
graphdb__auth__openid__issuer="${KC_HOSTNAME}/realms/${KC_REALM}"
graphdb__auth__openid__well_known_config_url="${KC_HOSTNAME}/realms/${KC_REALM}/.well-known/openid-configuration"
graphdb__auth__openid__client_id=${KC_GDB_CLIENT}
graphdb__auth__openid__token_type=access
graphdb__auth__openid__username_claim=preferred_username
graphdb__auth__openid__auth_flow=code
graphdb__auth__openid__token_audience=${KC_GDB_CLIENT}
graphdb__auth__openid__require_audience="true"
graphdb__auth__oauth__roles_claim="resource_access.${KC_GDB_CLIENT}.roles"
graphdb__auth__oauth__default_roles=ROLE_USER

# PoolParty Graph Modeling OAuth2 Client Settings (used in oauth.yaml)
POOLPARTY_GRAPHDB_OAUTH_CLIENTID=${KC_GDB_CLIENT}
POOLPARTY_GRAPHDB_OAUTH_SCOPES=openid,profile,roles,aud-graphdb

###############################################################################
# 7. ELASTICSEARCH (SEARCH & INDEX SUBSYSTEM)
###############################################################################
# PoolParty search indexing configuration
POOLPARTY_INDEX_TYPE=ELASTICSEARCH
POOLPARTY_INDEX_URL=http://elasticsearch:9200
POOLPARTY_INDEX_USERNAME=elastic
POOLPARTY_INDEX_PASSWORD=

# Elasticsearch Container Settings
# Used by orchestrator in files/elasticsearch/upgrade-elasticsearch.sh for legacy upgrades
ELASTICSEARCH_VERSION=9.3.3
# Matches POOLPARTY_INDEX_PASSWORD for Elasticsearch container startup
ELASTIC_PASSWORD=${POOLPARTY_INDEX_PASSWORD}
discovery.type=single-node
xpack.security.enabled=false

# JVM memory options passed to Elasticsearch container in docker-compose.yaml
ES_JAVA_TOOL_OPTIONS=-Xms8g -Xmx8g
# Legacy Elasticsearch JVM option (kept commented for backward compatibility with custom scripts)
#ES_JAVA_OPTS=-Xms8g -Xmx8g

###############################################################################
# 8. APACHE SPARK (OPTIONAL SERVICE)
###############################################################################
# Address of the Spark master service (used with spark.yaml)
POOLPARTY_SPARK_ADDRESS=spark://spark:7077

###############################################################################
# 9. KEYCLOAK AUTOMATED MIGRATIONS & ORCHESTRATION (ADVANCED / OPTIONAL)
###############################################################################
# The following variables allow fine-tuning Keycloak migration and startup orchestration:
# Controls mandatory password update for the imported `superadmin` user (default: true)
#SUPERADMIN_REQUIRES_ACTIONS=true

# Enables/disables automatic migration execution on container startup (default: true)
#AUTO_MIGRATION_ENABLED=true

# Target realm identifier for the migration (default: poolparty)
#POOLPARTY_KEYCLOAK_REALM=poolparty

# Target semantic version the orchestrator will attempt to reach
#TARGET_MIGRATION_VERSION=2.6.2

# Baseline version assumed for realms with no migration_version attribute (default: 2.3.0)
#MIGRATION_BASELINE_VERSION=2.3.0

# Overrides version read from the realm (manual recovery/testing only)
#CURRENT_VERSION=2.5.0

# Timeouts in seconds for readiness checks, script execution, and locks
#MIGRATION_TIMEOUT=300
#MIGRATION_READINESS_TIMEOUT=300
#MIGRATION_REALM_TIMEOUT=300
#MIGRATION_SCRIPT_TIMEOUT=900
#MIGRATION_LOCK_TIMEOUT=600

# File locations & logging
#MIGRATION_HEALTH_SIGNAL_FILE=/opt/keycloak/data/migration_done
#MIGRATION_LOG_FILE=/opt/keycloak/data/migration.log
#MIGRATIONS_BASE_DIR=/opt/keycloak/migrations
#MIGRATION_LOCK_DIR=/tmp
#MIGRATION_LOG_DEBUG=false
#MIGRATION_LOG_MAX_BYTES=5242880

###############################################################################
# 10. ADD-ON SERVICES (ADF, SEMANTIC WORKBENCH, UNIFIEDVIEWS)
###############################################################################
# UnifiedViews License & Nginx Proxy
UNIFIEDVIEWS_LICENSE=/path/to/uv-license.key
UV_PROXY_CONFIG_PATH=./files/nginx/uv-proxy.conf

# UnifiedViews Remote Host Settings (used only with unified-views.yaml)
# Set these if the PoolParty host's FQDN does not resolve via DNS from the UV host:
#POOLPARTY_SERVER_NAME=poolparty.example.com
#POOLPARTY_HOST_IP=10.0.0.5

###############################################################################
# 11. MIGRATION FROM POOLPARTY 9.X (MIGRATION.YAML ONLY)
###############################################################################
# Host path to the PoolParty 9 installation directory (used when mounting in migration.yaml)
#POOLPARTY_9_DIR=/opt/poolparty-9