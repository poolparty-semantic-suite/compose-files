# common configurations

# Hostname (DNS, IP) of the server hosting PoolParty and related services.
SERVER_NAME=poolparty.127.0.0.1.nip.io
# Base HTTP address of the server used to access PoolParty. Also used to construct Keycloak URL.
SERVER_URL="http://${SERVER_NAME}"

# Common KC settings
KC_REALM=poolparty
KC_GM_CLIENT=ppt
KC_GDB_CLIENT=graphdb

# proxy (nginx) configuration
PROXY_CLIENT_MAX_BODY_SIZE=100M
PROXY_SEND_TIMEOUT=5m
PROXY_READ_TIMEOUT=5m
PROXY_CONFIG_PATH=./files/nginx/proxy.conf
PROXY_CERT_PATH=./poolparty.crt
PROXY_CERT_KEY_PATH=./poolparty.key

# Keycloak URLs
POOLPARTY_KEYCLOAK_INTERNAL_AUTHURL="http://keycloak:8080/auth"
POOLPARTY_KEYCLOAK_PUBLIC_AUTHURL="${SERVER_URL}/auth"
POOLPARTY_KEYCLOAK_AUTHURL="${POOLPARTY_KEYCLOAK_INTERNAL_AUTHURL}"

# PoolParty
POOLPARTY_LICENSE=./pp/poolparty.key
POOLPARTY_CORS_ALLOWEDORIGINS=${SERVER_URL}
PP_HEAP_SIZE=8g

# The name of the PoolParty realm in Keycloak
POOLPARTY_KEYCLOAK_LOGIN_REALM=poolparty
POOLPARTY_KEYCLOAK_ADMIN_REALM=master

# Mandatory for requesting tokens
POOLPARTY_KEYCLOAK_ADMIN_CLIENTID=admin-cli
POOLPARTY_KEYCLOAK_ADMIN_USERNAME=poolparty_auth_admin
POOLPARTY_KEYCLOAK_ADMIN_PASSWORD=admin
POOLPARTY_SUPER_ADMIN_PASSWORD=poolparty

# PPX Config
POOLPARTY_PPX_KEYCLOAK_LOGIN_CLIENTSECRET=poolparty
POOLPARTY_PPX_KEYCLOAK_LOGIN_CLIENTID=extractor

# PPGS Config
POOLPARTY_PPGS_KEYCLOAK_LOGIN_CLIENTSECRET=poolparty
POOLPARTY_PPGS_KEYCLOAK_LOGIN_CLIENTID=ppgs

# PPT Config
POOLPARTY_PPT_KEYCLOAK_LOGIN_CLIENTSECRET=poolparty
POOLPARTY_PPT_KEYCLOAK_LOGIN_CLIENTID=ppt

# Recommender Config
RECOMMENDER_KEYCLOAK_LOGIN_CLIENTSECRET=poolparty

# Addon Client Secrets
ADF_KEYCLOAK_LOGIN_CLIENTSECRET=adf
SEMANTIC_WORKBENCH_KEYCLOAK_LOGIN_CLIENTSECRET=semantic-workbench
GRAPHVIEWS_KEYCLOAK_LOGIN_CLIENTSECRET=graphviews

# Optional Keycloak group paths for 2.7.0 migration
#ADF_MIGRATION_USER_GROUP_PATH=/ADFUsers
#SEMANTIC_WORKBENCH_MIGRATION_USER_GROUP_PATH=/SemanticWorkbenchUsers
#GRAPHVIEWS_MIGRATION_USER_GROUP_PATH=/GraphViewsUsers

POOLPARTY_AUTH_OPENID_REQUIRE_AUDIENCE=true

# Elasticsearch properties
POOLPARTY_INDEX_TYPE=ELASTICSEARCH
POOLPARTY_INDEX_URL=http://elasticsearch:9200
POOLPARTY_INDEX_USERNAME=
POOLPARTY_INDEX_PASSWORD=

# GraphDB connection URL
POOLPARTY_GRAPHDB_URL=http://graphdb:7200
GRAPHDB_PUBLIC_URL=http://graphdb:7200

# Spark
POOLPARTY_SPARK_ADDRESS=spark://spark:7077

_POOLPARTY_URL_BASE_SCHEME=${SERVER_URL}
_POOLPARTY_URL_BASE_VOCABULARY=${SERVER_URL}
_POOLPARTY_URL_BASE_USER=${SERVER_URL}/user
_POOLPARTY_URL_BASE_CONTEXT=${SERVER_URL}
_POOLPARTY_ENCRYPTION_PASSWORD=1234567890

# GraphDB
GRAPHDB_LICENSE=./gdb/graphdb.license
graphdb__external___url="${SERVER_URL}/graphdb"

# Keycloak and Postgres configuration
KC_PROXY_HEADERS=xforwarded
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_HOSTNAME="${SERVER_URL}/auth"
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KEYCLOAK_ADMIN=poolparty_auth_admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_USERNAME=kc_user
KC_DB_PASSWORD=secret
KC_DB_URL_DATABASE=keycloak
KC_DB_URL_HOST=db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# ElasticSearch
ELASTICSEARCH_VERSION=9.3.3
discovery.type=single-node
xpack.security.enabled=false
ES_JAVA_OPTS=-Xms8g -Xmx8g

# UnifiedViews
UNIFIEDVIEWS_LICENSE=/path/to/uv-license.key
UV_PROXY_CONFIG_PATH=./files/nginx/uv-proxy.conf
